{
  "name": "awehitch",
  "version": "0.2.1",
  "description": "Hitch the ChatGPT web brain to any coding agent. The agent executes; ChatGPT thinks.",
  "type": "module",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "skill",
    "examples",
    "README.md",
    "README_cn.md",
    "LICENSE"
  ],
  "bin": {
    "awehitch": "./bin/awehitch.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "playwright": "^1.49.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
